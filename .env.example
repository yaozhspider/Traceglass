# Export these values in the shell before launching traceglass.
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
# Existing reverse project (read-only source for model, Skills and domain tools).
TRACEGLASS_LEGACY_PROJECT=
TRACEGLASS_DATA_DIR=traceglass-data
TRACEGLASS_MAX_ITERS=2000
TRACEGLASS_WORKSPACE_BACKEND=docker
TRACEGLASS_SANDBOX_IMAGE=local/traceglass-analysis:latest
# Optional: existing Skill packages, read-only source; copied to new workspaces.
TRACEGLASS_SKILL_ROOTS=
# Optional native MCPClient JSON list (see docs/SKILLS_AND_TOOLS.md).
TRACEGLASS_MCP_CONFIG=
# Optional REA container kit; Docker image from MANIFEST.json must be loaded.
TRACEGLASS_REA_KIT=
# Per-process resident REA connection budget; text-only agents do not consume it.
TRACEGLASS_REA_MAX_CONNECTIONS=10
# Wait for a free slot before reporting capacity exhaustion; finite positive seconds.
TRACEGLASS_REA_QUEUE_WAIT_SECONDS=30
# No active call is interrupted. Pauses/approval waits still count as idle; 0 disables reaping.
TRACEGLASS_REA_IDLE_SECONDS=600
# New sessions validate archived references; legacy sessions/replay retain compatible mode.
TRACEGLASS_STRICT_EVIDENCE_REFERENCES=true
# Optional IDA MCP reachable from the Docker workspace.
IDA_ENABLED=false
IDA_MCP_URL=http://host.docker.internal:8745/mcp

# Enable ONLY when IDA MCP runs on the same host/filesystem as this API.
TRACEGLASS_IDA_LOCAL_FILES=false

# Additional exact HTTPS origins for self-hosted models; keep default provider hosts.
# No /v1 path here. Custom ports must be explicitly configured.
# TRACEGLASS_MODEL_ALLOWED_ORIGINS=https://model.example.com:8001
TRACEGLASS_MODEL_ALLOWED_ORIGINS=
# Optional administrator-managed private CA / TLS identity profiles (JSON file).
# Used by model discovery, connection tests and native leader/worker inference.
TRACEGLASS_MODEL_TLS_CONFIG=
# Optional host-managed Windows/ESXi tools; see docs/WINDOWS_GUEST_TOOLS.md.
# Private administrator JSON references password environment variables.
TRACEGLASS_WINDOWS_CONFIG=
