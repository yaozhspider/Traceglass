{
  "allowed_verdicts": [
    "hardened_in_scope"
  ],
  "allowed_exploitability": [
    "none"
  ],
  "required_vuln_classes": [
    "none"
  ],
  "requires_gaps": true,
  "required_facts": [
    {
      "category": "entry",
      "pattern": "handle_request|request"
    },
    {
      "category": "sink",
      "pattern": "execv|argv"
    },
    {
      "category": "constant",
      "pattern": "/usr/bin/printf"
    },
    {
      "category": "constraint",
      "pattern": "(separate.*argument|argument.*data|no.*shell|fixed.*format)"
    }
  ]
}
